{
  "name": "school-class",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @school-class/shared build && pnpm --parallel --filter @school-class/backend --filter @school-class/game --filter @school-class/admin dev",
    "dev:db": "docker compose -f docker-compose.dev.yml up -d",
    "dev:db:down": "docker compose -f docker-compose.dev.yml down",
    "dev:backend": "pnpm --filter @school-class/backend dev",
    "dev:game": "pnpm --filter @school-class/game dev",
    "dev:admin": "pnpm --filter @school-class/admin dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test"
  }
}
