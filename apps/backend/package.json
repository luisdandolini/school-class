{
  "name": "@school-class/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "prisma generate",
    "dev": "tsx watch --exclude \"./src/generated/**\" --env-file=.env src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma generate && tsx --env-file=.env src/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.0",
    "@fastify/jwt": "10.2.7",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/websocket": "11.3.7",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@school-class/shared": "workspace:*",
    "bcryptjs": "3.0.3",
    "dotenv": "^18.0.9",
    "fastify": "5.12.8",
    "fastify-plugin": "^6.0.1",
    "prisma": "7.10.1",
    "zod": "4.6.7"
  }
}
