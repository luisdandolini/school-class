generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
}

enum TaskType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  FILL_BLANK
  OPEN
}

/// Aluno ou professor.
model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  xp           Int      @default(0)
  /// Visual do personagem ({ style, skin, hair, shirt }); null = ainda não escolheu.
  avatar       Json?
  createdAt    DateTime @default(now())
  /// Professor que cadastrou este aluno (null para professores).
  createdById  String?

  createdBy       User?            @relation("CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  studentsCreated User[]           @relation("CreatedBy")

  enrollments Enrollment[]
  submissions Submission[]
  completions TaskCompletion[]
  worldsOwned World[]      @relation("WorldOwner")
}

/// Um "servidor": mundo temático (ex.: "Geografia - 7º ano").
model World {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  mapKey      String   @default("starter")
  ownerId     String
  createdAt   DateTime @default(now())

  owner       User         @relation("WorldOwner", fields: [ownerId], references: [id])
  npcs        Npc[]
  enrollments Enrollment[]
}

/// Quais alunos participam de quais mundos.
model Enrollment {
  userId    String
  worldId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@id([userId, worldId])
}

model Npc {
  id       String @id @default(cuid())
  worldId  String
  name     String
  greeting String
  sprite   String @default("npc")
  x        Int
  y        Int

  world World  @relation(fields: [worldId], references: [id], onDelete: Cascade)
  tasks Task[]
}

model Task {
  id       String   @id @default(cuid())
  npcId    String
  type     TaskType
  prompt   String
  /// Alternativas (MULTIPLE_CHOICE).
  options  String[]
  /// Resposta correta. NUNCA é enviada ao jogo. Null para OPEN.
  /// FILL_BLANK aceita várias respostas separadas por "|" (ex.: "56|cinquenta e seis").
  answer   String?
  xpReward Int      @default(10)
  order    Int      @default(0)

  npc         Npc              @relation(fields: [npcId], references: [id], onDelete: Cascade)
  submissions Submission[]
  completions TaskCompletion[]

  @@index([npcId, order])
}

/// Cada resposta enviada por um aluno.
model Submission {
  id        String   @id @default(cuid())
  userId    String
  taskId    String
  answer    String
  /// null = aguardando correção do professor (tarefas OPEN).
  correct    Boolean?
  xpGained   Int       @default(0)
  createdAt  DateTime  @default(now())
  /// Comentário do professor ao corrigir uma resposta aberta.
  feedback   String?
  reviewedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, taskId])
  @@index([taskId, correct])
}

/// Tarefa concluída por um aluno. A chave (userId, taskId) garante que o XP
/// de cada tarefa seja concedido uma única vez, mesmo com envios simultâneos.
model TaskCompletion {
  userId      String
  taskId      String
  xpGained    Int
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([userId, taskId])
}
